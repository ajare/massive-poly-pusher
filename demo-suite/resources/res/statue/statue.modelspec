<?xml version="1.0"?>
<Specification>

	<Buffers indexed="true" primitive="triangles" storage="static">
		<Buffer>
			<Channel data="position3" type="float32" />
			<Channel data="normal3" type="float32" />
			<Channel data="texcoord2" type="float16" />
			<Channel data="colour4" type="uint8" normalised="true" />
		</Buffer>
	</Buffers>
	
	<!--
	Every model has its own set of Materials, even if those Materials use already-existing
	shaders or textures.
	-->>
	<Materials>
		<!-- Material name should match those defined in the .mtl file. -->
		<Material name="statue_material">
			<!-- positionType attribute is either '2D' or '3D' -->
			<Program positionType="3D">
				<!--
				Shaders are either filenames, or if empty, use the default shaders.
				-->
				<Shaders>
					<Shader type="Vertex"></Shader>
					<Shader type="Fragment">statue_lighting.frag</Shader>
				</Shaders>
			</Program>

			<Textures>
				<!-- 
				Textures either use a 'filename' attribute to specify filename, or a 'resource' attribute
				to specify an existing loaded texture resource.  If filename, the generated Texture resource
				is named modelname/materialname/filename.
				-->
				<Texture binding="TEX1" filename="statue_marble.jpg" />
				<Texture binding="TEX2" resource="rgba.png" />
			</Textures>
			
			<Uniforms>
				<Uniform name="SPEC_EXPONENT" type="float" value="32" />
				<Uniform name="SPEC_STRENGTH" type="float" value="0.5" />
			</Uniforms>
		</Material>
	</Materials>

</Specification>