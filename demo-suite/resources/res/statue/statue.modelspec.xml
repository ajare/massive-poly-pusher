<?xml version="1.0"?>
<ModelSpecification>

	<MeshSpecification>
		<primitive>triangles</primitive>
		<indexed>true</indexed>
		<storage>static</storage>
		
		<Buffer>
			<Channel>
				<data>position3</data>
				<type>float32</type>
			</Channel>
			<Channel>
				<data>normal3</data>
				<type>float32</type>
			</Channel>
			<Channel>
				<data>tangent4</data>
				<type>float32</type>
			</Channel>
			<Channel>
				<data>texcoord2</data>
				<type>float16</type>
			</Channel>
			<Channel>
				<data>colour4</data>
				<type>uint8</type>
				<normalised>true</normalised>
			</Channel>
		</Buffer>
	</MeshSpecification>					
	
	<!--
	Every model has its own set of Materials, even if those Materials use already-existing
	shaders or textures.
	-->
	<Materials>
		<!-- Material name should match those defined in the .mtl file. -->
		<Material>
			<name>statue_material</name>
			<Resource>
				<Program>
					<Resource>
						<positionType>3D</positionType>
						<textures>1</textures>			
					
						<VertexShader>
							<file>statue_pbr.vert</file>
						</VertexShader>
						<FragmentShader>
							<file>statue_pbr.frag</file>
						</FragmentShader>
						
						<!-- Override global meshspec.
						<MeshSpecification>
							<primitive>triangles</primitive>
							<indexed>true</indexed>
							<storage>static</storage>
							
							<Buffer>
								<Channel>
									<data>position3</data>
									<type>float32</type>
								</Channel>
								<Channel>
									<data>normal3</data>
									<type>float32</type>
								</Channel>
								<Channel>
									<data>texcoord2</data>
									<type>float16</type>
								</Channel>
								<Channel>
									<data>colour4</data>
									<type>uint8</type>
									<normalised>true</normalised>
								</Channel>
							</Buffer>
						</MeshSpecification>
                        -->
					</Resource>
				</Program>
				
				<!-- Metallic-roughness PBR material parameters. Texture slots will be
				     supplied by the PBR shader/material in later milestones. -->
				<Pbr>
					<baseColourFactor>1.0 1.0 1.0 1.0</baseColourFactor>
					<metallicFactor>0.0</metallicFactor>
					<roughnessFactor>0.75</roughnessFactor>
					<emissiveFactor>0.0 0.0 0.0</emissiveFactor>
					<normalScale>1.0</normalScale>
					<occlusionStrength>1.0</occlusionStrength>
					<alphaMode>OPAQUE</alphaMode>
					<alphaCutoff>0.5</alphaCutoff>
					<doubleSided>false</doubleSided>
				</Pbr>

				<Textures>
					<Texture>
						<Variable>PBR_BASE_COLOUR_MAP</Variable>
						<Resource>
							<target>2D</target>
							<filename>statue_marble.jpg</filename>
							<colourSpace>SRGB</colourSpace>
							<minFilter>LINEAR</minFilter>
							<magFilter>LINEAR</magFilter>
						</Resource>
					</Texture>
					<Texture>
						<Variable>PBR_IRRADIANCE_MAP</Variable>
						<Ref>PBR.Preview.Environment</Ref>
					</Texture>
					<Texture>
						<Variable>PBR_PREFILTERED_SPECULAR_MAP</Variable>
						<Ref>PBR.Preview.Environment</Ref>
					</Texture>
					<Texture>
						<Variable>PBR_BRDF_LUT</Variable>
						<Ref>PBR.Preview.BrdfLut</Ref>
					</Texture>
				</Textures>
				
				<Uniforms>
					<Uniform>
						<name>SPEC_EXPONENT</name>
						<type>float</type>
						<value>16</value>
					</Uniform>
					<Uniform>
						<name>SPEC_STRENGTH</name>
						<type>float</type>
						<value>0.5</value>
					</Uniform>
				</Uniforms>
			</Resource>
		</Material>
	</Materials>

</ModelSpecification>