<?xml version="1.0"?>
<ModelSpecification>

	<MeshSpecification>
		<primitive>triangles</primitive>
		<indexed>true</indexed>
		<storage>static</storage>

		<Buffer>
			<Channel>
				<data>position3</data>
				<type>float32</type>
			</Channel>
			<Channel>
				<data>normal3</data>
				<type>float32</type>
			</Channel>
			<Channel>
				<data>tangent4</data>
				<type>float32</type>
			</Channel>
			<Channel>
				<data>texcoord2</data>
				<type>float16</type>
			</Channel>
			<Channel>
				<data>colour4</data>
				<type>uint8</type>
				<normalised>true</normalised>
			</Channel>
		</Buffer>
	</MeshSpecification>

	<!--
	Every model has its own set of Materials, even if those Materials use already-existing
	shaders or textures.
	-->
	<Materials>
		<!-- Material name should match those defined in the .mtl file. -->
		<PbrMaterial>
			<name>statue_material</name>
				<Program>
					<Resource>
						<positionType>3D</positionType>
						<textures>1</textures>

						<VertexShader>
							<file>statue_pbr.vert</file>
						</VertexShader>
						<FragmentShader>
							<file>statue_pbr.frag</file>
						</FragmentShader>
					</Resource>
				</Program>

				<!-- Metallic-roughness PBR material parameters. Texture slots will be
				     supplied by the PBR shader/material in later milestones. -->
				<Surface>
					<baseColourFactor>1.0 1.0 1.0 1.0</baseColourFactor>
					<metallicFactor>0.0</metallicFactor>
					<roughnessFactor>0.75</roughnessFactor>
					<emissiveFactor>0.0 0.0 0.0</emissiveFactor>
					<normalScale>1.0</normalScale>
					<occlusionStrength>1.0</occlusionStrength>
					<alphaMode>OPAQUE</alphaMode>
					<alphaCutoff>0.5</alphaCutoff>
					<doubleSided>false</doubleSided>
				</Surface>
				<Extensions>
					<Uniform><name>PBR_EXT_EMISSIVE_SCALE</name><type>float</type><value>1.0</value></Uniform>
				</Extensions>

				<BaseColourMap><Resource>
					<target>2D</target><filename>stone-1024__Jpg_albedo.png</filename><colourSpace>SRGB</colourSpace>
					<minFilter>LINEAR</minFilter><magFilter>LINEAR</magFilter>
				</Resource></BaseColourMap>
				<MetallicRoughnessMap><Resource>
					<target>2D</target><filename>stone-1024__Jpg_ORM.png</filename><colourSpace>LINEAR</colourSpace>
					<minFilter>LINEAR</minFilter><magFilter>LINEAR</magFilter>
				</Resource></MetallicRoughnessMap>
				<NormalMap><Resource>
					<target>2D</target><filename>stone-1024__Jpg_normal.png</filename><colourSpace>LINEAR</colourSpace>
					<minFilter>LINEAR</minFilter><magFilter>LINEAR</magFilter>
				</Resource></NormalMap>
				<OcclusionMap><Resource>
					<target>2D</target><filename>stone-1024__Jpg_ao.png</filename><colourSpace>LINEAR</colourSpace>
					<minFilter>LINEAR</minFilter><magFilter>LINEAR</magFilter>
				</Resource></OcclusionMap>
		</PbrMaterial>
	</Materials>

</ModelSpecification>