<PbrPipeline>
  <version>1</version>
  <name>Empty Pipeline</name>
  <Bloom>
    <enabled>false</enabled>
    <blurPasses>0</blurPasses>
  </Bloom>
  <Imports>
    <Import>
      <id>screen</id>
      <semantic>presentation</semantic>
      <format>RGBA8</format>
      <usage>colourAttachment,presentation</usage>
      <required>true</required>
    </Import>
  </Imports>
  <Outputs>
    <Output>
      <name>Main</name>
      <image>Presentation</image>
      <AntiAliasing>
        <msaa>inherit</msaa>
        <ssaa>inherit</ssaa>
        <taa>inherit</taa>
        <fxaa>inherit</fxaa>
      </AntiAliasing>
    </Output>
  </Outputs>
  <RenderGraph>
    <Images>
      <Image>
        <name>Presentation</name>
        <format>RGBA8</format>
        <usage>sampled,colourAttachment,presentation</usage>
        <import>screen</import>
        <external>true</external>
        <transient>false</transient>
      </Image>
    </Images>
    <Passes />
  </RenderGraph>
</PbrPipeline>