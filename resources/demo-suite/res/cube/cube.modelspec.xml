<?xml version="1.0"?>
<ModelSpecification>

	<MeshSpecification>
		<primitive>triangles</primitive>
		<indexed>true</indexed>
		<storage>static</storage>
		
		<Buffer>
			<Channel>
				<data>position3</data>
				<type>float32</type>
			</Channel>
			<Channel>
				<data>normal3</data>
				<type>float32</type>
			</Channel>
			<Channel>
				<data>texcoord2</data>
				<type>float16</type>
			</Channel>
			<Channel>
				<data>colour4</data>
				<type>uint8</type>
				<normalised>true</normalised>
			</Channel>
		</Buffer>
	</MeshSpecification>					
	
	<!--
	Every model has its own set of Materials, even if those Materials use already-existing
	shaders or textures.
	-->
	<Materials>
		<!-- Material name should match those defined in the .mtl file. -->
		<BasicMaterial>
			<name>cube_material</name>
				<Program>
					<Resource>
						<positionType>3D</positionType>
						<textures>1</textures>			
					
						<FragmentShader>
							<file>cube_lighting.frag</file>
						</FragmentShader>
						
						<!-- Override global meshspec.
						<MeshSpecification>
							<primitive>triangles</primitive>
							<indexed>true</indexed>
							<storage>static</storage>
							
							<Buffer>
								<Channel>
									<data>position3</data>
									<type>float32</type>
								</Channel>
								<Channel>
									<data>normal3</data>
									<type>float32</type>
								</Channel>
								<Channel>
									<data>texcoord2</data>
									<type>float16</type>
								</Channel>
								<Channel>
									<data>colour4</data>
									<type>uint8</type>
									<normalised>true</normalised>
								</Channel>
							</Buffer>
						</MeshSpecification>	
                        -->
					</Resource>
				</Program>
				
				<Textures>
					<Texture>
						<Variable>TEX1</Variable>
						<Resource>
							<target>2D</target>
							<filename>lattice.jpg</filename>
							<minFilter>LINEAR</minFilter>
							<magFilter>LINEAR</magFilter>
						</Resource>
					</Texture>
				</Textures>
				
				<Uniforms>
					<Uniform>
						<name>SPEC_EXPONENT</name>
						<type>float</type>
						<value>16</value>
					</Uniform>
					<Uniform>
						<name>SPEC_STRENGTH</name>
						<type>float</type>
						<value>0.5</value>
					</Uniform>
				</Uniforms>
		</BasicMaterial>
	</Materials>

</ModelSpecification>