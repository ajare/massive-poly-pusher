<?xml version="1.0"?>
<BasicMaterial>
	<Program>
		<Resource>
			<positionType>3D</positionType>

			<FragmentShader>
				<file>lighting.frag</file>
				<!-- <resource></resource> String resource -->
			</FragmentShader>
			
			<textures>1</textures>

			<MeshSpecification>
				<primitive>triangles</primitive>
				<indexed>true</indexed>
				<storage>static</storage>
				
				<Buffer>
					<Channel>
						<data>position3</data>
						<type>float32</type>
					</Channel>
					<Channel>
						<data>normal3</data>
						<type>float32</type>
					</Channel>
					<Channel>
						<data>texcoord2</data>
						<type>float32</type>
					</Channel>
					<Channel>
						<data>colour4</data>
						<type>uint8</type>
						<normalised>true</normalised>
					</Channel>
				</Buffer>
			</MeshSpecification>
		</Resource>
	</Program>
	<Textures>
		<Texture>
			<Variable>TEX1</Variable>
			<Resource>
				<target>2D</target>
				<filename>electbubbles.jpg</filename>
				<minFilter>LINEAR</minFilter>
				<magFilter>LINEAR</magFilter>
				<sampler>Default.Sampler</sampler>
			</Resource>
		</Texture>
	</Textures>
	
	<Uniforms>
		<Uniform>
			<name>SPEC_EXPONENT</name>
			<type>float</type>
			<value>32</value>
		</Uniform>
		<Uniform>
			<name>SPEC_STRENGTH</name>
			<type>float</type>
			<value>0.5</value>
		</Uniform>
	</Uniforms>
</BasicMaterial>