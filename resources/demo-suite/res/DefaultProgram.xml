<?xml version="1.0"?>
<Program>
	<positionType>3D</positionType>
	
	<!-- If vertex and fragment shader are not specified, generate them from default -->

	<textures>1</textures>

	<MeshSpecification>
		<primitive>triangles</primitive>
		<indexed>true</indexed>
		<storage>static</storage>
		
		<Buffer>
			<Channel>
				<data>position3</data>
				<type>float32</type>
			</Channel>
			<Channel>
				<data>normal3</data>
				<type>float32</type>
			</Channel>
			<Channel>
				<data>texcoord2</data>
				<type>float32</type>
			</Channel>
			<Channel>
				<data>colour4</data>
				<type>uint8</type>
				<normalised>true</normalised>
			</Channel>
		</Buffer>
	</MeshSpecification>
</Program>